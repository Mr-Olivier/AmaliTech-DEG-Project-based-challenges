# How to use this file:
# 1. Copy it:  cp .env.example .env
# 2. Fill in your values
# 3. Never commit the real .env file — it is already in .gitignore


# ---------------------------------------------------------------------------
# App settings  (docker-compose reads these and passes them to the container)
# ---------------------------------------------------------------------------

PORT=3000


# ---------------------------------------------------------------------------
# GitHub Repository Secrets
# Go to: GitHub repo → Settings → Secrets and variables → Actions → New secret
# These are NOT put in the .env file — GitHub injects them into the pipeline.
# ---------------------------------------------------------------------------

# Your AWS access key ID — get this after running: terraform output github_actions_access_key_id
AWS_ACCESS_KEY_ID=your_access_key_id_here

# Your AWS secret key — get this after running: terraform output -raw github_actions_secret_access_key
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here

# The public IP of your EC2 server — get this after running: terraform output ec2_public_ip
EC2_HOST=your_ec2_public_ip_here

# Your SSH private key (the full contents of ~/.ssh/id_rsa including the header and footer lines)
EC2_SSH_KEY=your_private_key_here


# ---------------------------------------------------------------------------
# Terraform variables  (go in terraform/terraform.tfvars, not here)
# Copy: terraform/terraform.tfvars.example → terraform/terraform.tfvars
# ---------------------------------------------------------------------------

# your_ip             = your public IP address — find it at https://whatismyip.com
# ssh_public_key_path = path to your .pub file, e.g. ~/.ssh/id_rsa.pub
# aws_region          = us-east-1
# ecr_repository_name = kora-analytics-api
# alert_email         = your email for CloudWatch alarm alerts (optional)
