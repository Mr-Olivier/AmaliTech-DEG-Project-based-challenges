# Copy to .env and fill in your values. Never commit the real .env.

# app
PORT=3000

# GitHub Actions secrets — set these in repo → Settings → Secrets and variables → Actions
# (these are not loaded from .env; GitHub injects them into the pipeline)
AWS_ACCESS_KEY_ID=your_access_key_id_here        # terraform output github_actions_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key_here # terraform output -raw github_actions_secret_access_key
EC2_HOST=your_ec2_public_ip_here                 # terraform output ec2_public_ip
EC2_SSH_KEY=your_private_key_here                # full contents of ~/.ssh/id_rsa
SG_ID=your_security_group_id_here               # terraform output security_group_id

# Terraform variables go in terraform/terraform.tfvars (see terraform.tfvars.example)
